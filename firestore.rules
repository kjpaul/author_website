rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /errata/{errataId} {
      // Anyone can read confirmed/fixed errata
      allow read: if resource.data.status in ["confirmed", "fixed"];

      // Admin can read all errata (including pending/rejected)
      allow read: if request.auth != null
                  && request.auth.token.email == "paul@orbitalring.space";

      // No direct client writes. New errata come in through the submitErrata
      // Cloud Function (Admin SDK), which verifies Turnstile + honeypot first.

      // Only admin can update or delete
      allow update, delete: if request.auth != null
                            && request.auth.token.email == "paul@orbitalring.space";
    }
  }
}
