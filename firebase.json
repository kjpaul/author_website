        "type": 301
      },
      {
        "source": "/series/technical/orbital-rings/vol-2/references/index.html",
        "destination": "/series/technical/orbital-rings/vol-3/references",
        "type": 301
      },
      {
        "source": "/series/technical/orbital-rings/vol-4",
        "destination": "/series/related/why-space",
        "type": 301
      },
      {
        "source": "/series/technical/orbital-rings/vol-4/",
        "destination": "/series/related/why-space",
        "type": 301
      },
      {
        "source": "/series/technical/orbital-rings/vol-4/references",
        "destination": "/series/related/why-space/references",
        "type": 301
      },
      {
        "source": "/series/technical/orbital-rings/vol-4/references/",
