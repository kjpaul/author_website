      },
      {
        "source": "/series/fiction/humanitys-next-chapter/",
        "destination": "/series/fiction/the-great-beyond",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/subscribe",
        "function": "subscribe"
      },
      {
        "source": "/api/submit-errata",
        "function": "subscribe"
      }
    ],
    "headers": [
      {
        "source": "/data/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/admin/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "private, no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "*.local"
      ]
    }
  ]
}
