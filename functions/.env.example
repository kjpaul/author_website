# Copy this file to .env (kept out of git) for local emulator runs only.
# Production uses `firebase functions:secrets:set MAILERLITE_API_KEY` plus
# the three group-ID env vars set via `firebase functions:config:set` or
# inline in the deploy environment.

MAILERLITE_API_KEY=paste-only-for-local-emulator-testing
MAILERLITE_GROUP_VOL1=
MAILERLITE_GROUP_VOL23=
MAILERLITE_GROUP_PROGRESS=

# Errata email notification (onErrataCreated).
# The API key is a SECRET — set it with:
#   firebase functions:secrets:set RESEND_API_KEY
# (paste here only for local emulator testing).
RESEND_API_KEY=paste-only-for-local-emulator-testing
# Where errata notifications are sent.
ERRATA_NOTIFY_TO=author@pauldejong.com
# From header. Use onboarding@resend.dev until pauldejong.com is verified in Resend.
RESEND_FROM=Orbital Ring Errata <onboarding@resend.dev>
# Link to the admin dashboard, included in the notification email.
ADMIN_DASHBOARD_URL=https://pauldejong.com/errata/admin/
